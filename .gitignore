node_modules/
npm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Local documents - keep real data out of the repo
*.pdf
*.eml
*.mbox
*.csv

# Apps Script editor tooling - generated typings and the config that points at them
.gas-sync/
jsconfig.json
